# Copy to src/main/resources/db.properties for local IntelliJ development.
# Do NOT commit real secrets or API keys to public Git repositories.

# 1. SQL Server Configuration
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=ElectricCarSalesDB;encrypt=true;trustServerCertificate=true
DB_USER=sa
DB_PASSWORD=123456

# 2. Real Bank Transfer (VietQR - OCB) Configuration
OCB_BANK_ID=OCB
OCB_BANK_BIN=970448
OCB_ACCOUNT_NO=0917231548
OCB_ACCOUNT_NAME=DO TAN DAT

# 3. Payment Test Mode (false = 100% RDS amount; true = allow 1/1000 technical test transfer amount)
# Note: Even in test mode, an order is NEVER marked DEPOSITED or PAID unless full RDS amount is verified.
PAYMENT_TEST_MODE=false

# 4. Bank Webhook Verification Secret (Casso / SePay / OCB Open API)
BANK_WEBHOOK_SECRET=YOUR_BANK_WEBHOOK_SECRET

# 5. VNPay Official Merchant Configuration (leave blank if not registered)
VNPAY_TMN_CODE=YOUR_VNPAY_TMN_CODE
VNPAY_HASH_SECRET=YOUR_VNPAY_HASH_SECRET
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8080/ElectricCarSales/payment/vnpay-return

# 6. MoMo Official Merchant Configuration (leave blank if not registered)
MOMO_PARTNER_CODE=YOUR_MOMO_PARTNER_CODE
MOMO_ACCESS_KEY=YOUR_MOMO_ACCESS_KEY
MOMO_SECRET_KEY=YOUR_MOMO_SECRET_KEY
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL=http://localhost:8080/ElectricCarSales/payment/momo-return
MOMO_IPN_URL=http://localhost:8080/ElectricCarSales/payment/callback?provider=momo
