# Copy with Setup-LocalConfig.ps1, then fill in the SQL Server address and credentials for this machine.
# Adjust host and port to match your local instance. Remove DB_USER and DB_PASSWORD for integrated auth.
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=ElectricCarSalesDB;encrypt=true;trustServerCertificate=true
DB_USER=your_sql_login
DB_PASSWORD=your_sql_password
