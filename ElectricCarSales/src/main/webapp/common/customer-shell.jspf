<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%
response.setCharacterEncoding("UTF-8");
String customerContext = request.getContextPath();
String customerPage = request.getRequestURI().substring(request.getRequestURI().lastIndexOf('/') + 1);
if ("profile".equals(customerPage)) customerPage = "profile".equals(request.getParameter("view")) ? "my-profile.jsp" : "my-account.jsp";
String customerTitle = (String) request.getAttribute("customerTitle");
if (customerTitle == null) customerTitle = "Tài khoản của tôi";
String customerEyebrow = (String) request.getAttribute("customerEyebrow");
if (customerEyebrow == null) customerEyebrow = "VINFAST · ELECTRIC CAR SALE";
%>
<!doctype html>
<html lang="vi">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="theme-color" content="#101113">
        <title>
            <%= customerTitle %> · VinFast ElectricCarSale</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
        <% if ("ai-assistant.jsp".equals(customerPage)) { %>
        <link rel="stylesheet" href="<%= customerContext %>/assets/css/theme.css">
        <% } %>
        <link rel="stylesheet" href="<%= customerContext %>/assets/css/customer.css?v=customer-profile-route-20261116c">
        <% if ("ai-assistant.jsp".equals(customerPage)) { %>
        <link rel="stylesheet" href="<%= customerContext %>/assets/css/customer-ai.css?v=customer-ai-20261028">
        <% } %>
        <script src="<%= customerContext %>/assets/js/customer.js?v=customer-profile-email-lock-20261117a" defer>
        </script>
    </head>
    <body data-context-path="<%= customerContext %>">
        <div class="customer-app">
            <aside class="customer-sidebar" id="customer-sidebar">
                <a class="vf-brand" href="<%= customerContext %>/customer/profile" aria-label="VinFast ElectricCarSale">
                    <span class="vf-mark" aria-hidden="true">V</span>
                    <span class="vf-brand-copy">
                        <strong>VinFast</strong>
                        <small>ELECTRIC CAR SALE</small>
                    </span>
                </a>
                <div class="sidebar-caption">KHÔNG GIAN CỦA BẠN</div>
                <nav class="customer-nav" aria-label="Điều hướng khách hàng">
                    <a class="nav-link <%= customerPage.equals("my-account.jsp") ? "active" : "" %>" href="<%= customerContext %>/customer/profile">
                        <span class="nav-icon">⌂</span>
                        <span>Tổng quan</span>
                    </a>
                    <div class="nav-divider">
                        <span>GIAO DỊCH CỦA TÔI</span>
                    </div>
                    <a class="nav-link <%= ("my-orders.jsp".equals(customerPage) || "orders".equals(customerPage)) ? "active" : "" %>" href="<%= customerContext %>/orders">
                        <span class="nav-icon">▤</span>
                        <span>Đơn hàng</span>
                    </a>
                    <a class="nav-link <%= ("my-payments.jsp".equals(customerPage) || "history".equals(customerPage) || customerPage.contains("payment")) ? "active" : "" %>" href="<%= customerContext %>/payment/history">
                        <span class="nav-icon">◉</span>
                        <span>Thanh toán</span>
                    </a>
                    <a class="nav-link <%= ("my-contracts.jsp".equals(customerPage) || "contract".equals(customerPage)) ? "active" : "" %>" href="<%= customerContext %>/contract">
                        <span class="nav-icon">▧</span>
                        <span>Hợp đồng</span>
                    </a>
                    <a class="nav-link <%= customerPage.equals("ai-assistant.jsp") ? "active" : "" %>" href="<%= customerContext %>/customer/ai-assistant.jsp">
                        <span class="nav-icon">✳</span>
                        <span>AI tư vấn xe</span>
                        <span class="ai-tag">AI</span>
                    </a>
                    <div class="nav-divider">
                        <span>TÀI KHOẢN</span>
                    </div>
                    <a class="nav-link <%= customerPage.equals("my-profile.jsp") ? "active" : "" %>" href="<%= customerContext %>/customer/profile?view=profile">
                        <span class="nav-icon">◎</span>
                        <span>Hồ sơ cá nhân</span>
                    </a>
                    <a class="nav-link" href="<%= customerContext %>/index.jsp?view=customer#models">
                        <span class="nav-icon">↗</span>
                        <span>Khám phá xe</span>
                    </a>
                </nav>
                <form method="post" action="<%= customerContext %>/logout" style="margin:10px 13px 0;">
                    <button type="submit" class="nav-link" style="background:none;border:0;color:#fff;width:100%;cursor:pointer;text-align:left;">⎋ &nbsp;Đăng xuất</button>
                </form>
                <div class="sidebar-help">
                    <div class="help-orbit">✳</div>
                    <strong>Cần hỗ trợ?</strong>
                    <p>Đội ngũ VinFast luôn sẵn sàng đồng hành cùng bạn.</p>
                    <a href="mailto:hotro@electriccarsale.vn">Liên hệ hỗ trợ <span>↗</span>
                    </a>
                </div>
                <div class="sidebar-bottom">
                    <span class="status-dot"></span> Kết nối an toàn <span class="version-label">· Phiên khách hàng</span>
                </div>
            </aside>
            <div class="customer-main">
                <header class="customer-topbar">
                    <button class="mobile-menu" type="button" aria-label="Mở menu" aria-expanded="false" data-menu-toggle>☰</button>
                    <div class="breadcrumb">
                        <span>VinFast</span>
                        <i>/</i>
                        <strong>
                            <%= customerTitle %>
                        </strong>
                    </div>
                    <div class="topbar-actions">
                        <button class="icon-button notification-button" type="button" aria-label="Thông báo" data-notification>♧</button>
                        <span class="topbar-divider"></span>
                        <a class="user-chip" href="<%= customerContext %>/customer/profile?view=profile">
                            <span class="user-avatar" data-avatar-wrap>
                                <svg class="avatar-placeholder" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.8"/><path d="M4.5 21c.7-4.1 3.3-6.2 7.5-6.2s6.8 2.1 7.5 6.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                                <img data-avatar-image src="<%= customerContext %>/customer/avatar?v=<%= System.currentTimeMillis() %>" alt="Ảnh đại diện" hidden>
                            </span>
                            <span class="user-chip-copy">
                                <strong><c:out value="${empty sessionScope.displayName ? sessionScope.username : sessionScope.displayName}" default="Khách hàng" /></strong>
                                <small>Tài khoản cá nhân</small>
                            </span>
                            <span class="chevron">⌄</span>
                        </a>
                    </div>
                </header>
                <main class="customer-content">
                    <div class="page-heading">
                        <div>
                            <div class="eyebrow">
                                <span class="eyebrow-line"></span>
                                <%= customerEyebrow %>
                            </div>
                            <h1>
                                <%= customerTitle %>
                            </h1>
                        </div>
                        <div class="heading-actions">
                            <span class="secure-label">
                                <span>✓</span> Thông tin được bảo mật</span>
                        </div>
                    </div>
