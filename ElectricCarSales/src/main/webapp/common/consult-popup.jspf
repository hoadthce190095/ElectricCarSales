<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!-- POPUP TƯ VẤN KHÁCH HÀNG & TÍNH PHƯƠNG ÁN THANH TOÁN VINFAST (ĐỒNG BỘ GIAO DIỆN HỆ THỐNG) -->
<div id="ecs-consult-popup" class="ecs-consult-popup" hidden aria-label="Tư vấn xe và phương án thanh toán">
    <div class="ecs-consult-header" id="ecs-consult-header" title="Nhấp đúp chuột để phóng to / thu nhỏ">
        <div style="display:flex;align-items:center;gap:11px;">
            <span class="ecs-vf-mark" aria-hidden="true">V</span>
            <div>
                <strong style="font-size:12.5px;letter-spacing:0.2px;font-family:var(--display,'Manrope',sans-serif);">TƯ VẤN SẢN PHẨM &amp; PHƯƠNG ÁN THANH TOÁN</strong>
                <small style="display:flex;align-items:center;gap:5px;font-size:10.5px;color:#a5a7ac;margin-top:2px;">
                    <i style="width:6px;height:6px;border-radius:50%;background:#38ad7c;display:inline-block;"></i>
                    Dữ liệu VinFast chính thức · Kết nối trực tiếp Sales Staff
                </small>
            </div>
        </div>
        <div class="ecs-consult-actions">
            <button type="button" id="ecs-consult-fullscreen" title="Phóng to toàn màn hình / Thu nhỏ">⛶ Phóng to</button>
            <button type="button" id="ecs-consult-close" title="Đóng cửa sổ">✕</button>
        </div>
    </div>

    <div class="ecs-consult-body">
        <div class="ecs-consult-grid">
            <!-- CỘT 1: CHỌN MẪU XE & TÍNH TOÁN DỰ KIẾN -->
            <div class="ecs-consult-card">
                <div class="ecs-card-head">
                    <div>
                        <span class="ecs-overline">ƯỚC TÍNH CHI PHÍ</span>
                        <h3>1. Chọn mẫu xe &amp; Phương án dự kiến</h3>
                    </div>
                    <span class="ecs-step-tag">BƯỚC 1</span>
                </div>

                <label class="ecs-field">
                    <span>Mẫu xe VinFast quan tâm</span>
                    <select id="ecs-calc-model">
                        <option value="">Đang tải danh mục xe...</option>
                    </select>
                </label>

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:9px;">
                    <label class="ecs-field">
                        <span>Hình thức thanh toán</span>
                        <select id="ecs-calc-mode">
                            <option value="BANK_TRANSFER">Trả thẳng (Cọc 30% + Trả 70%)</option>
                            <option value="INSTALLMENT">Trả góp qua Ngân hàng đối tác</option>
                        </select>
                    </label>
                    <label class="ecs-field" id="ecs-plan-wrap" hidden>
                        <span>Đối tác tài chính</span>
                        <select id="ecs-calc-plan">
                            <option value="Techcombank" data-bank="Techcombank">Techcombank</option>
                            <option value="MB Bank" data-bank="MB Bank">MB Bank</option>
                            <option value="Shinhan Finance" data-bank="Shinhan Finance">Shinhan Finance</option>
                            <option value="VPBank" data-bank="VPBank">VPBank</option>
                        </select>
                    </label>
                </div>

                <div id="ecs-installment-options" hidden>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:9px;">
                        <label class="ecs-field"><span>Kỳ hạn vay</span><select id="ecs-calc-term"></select></label>
                        <label class="ecs-field"><span>Giá xe tham khảo (VND)</span><input id="ecs-calc-price" type="text" readonly placeholder="Tự lấy từ dữ liệu xe"></label>
                    </div>
                    <label class="ecs-field" style="margin-top:9px;"><span>Tỷ lệ trả trước (tối thiểu 30%)</span><input id="ecs-calc-down-rate" type="number" min="30" max="100" step="1" value="30"></label>
                </div>

                <div id="ecs-calc-summary" class="ecs-calc-summary"></div>

                <p class="ecs-footnote">
                    <span>i</span>
                    Giá xe và điều kiện vay thực tế do nhân viên kinh doanh và ngân hàng đối tác xác nhận khi lập hợp đồng.
                </p>
            </div>

            <!-- CỘT 2: KHUNG CHAT TƯ VẤN ĐỒNG BỘ GIAO DIỆN AI-ASSISTANT & CUSTOMER SHELL -->
            <div class="ecs-consult-card ecs-chat-card">
                <div class="ecs-chat-top">
                    <div class="ecs-chat-avatar">✳</div>
                    <div>
                        <strong id="ecs-consult-card-title">Trợ lý Tư vấn VinFast</strong>
                        <span><i></i> Hỗ trợ thông số xe &amp; kết nối Sales Staff</span>
                    </div>
                    <span id="ecs-consult-mode-badge" class="ecs-mode-badge">TRỰC TUYẾN</span>
                </div>

                <!-- LUỒNG KHÁCH CHƯA ĐĂNG NHẬP: KHUNG CHAT TRỰC QUAN GỌN ĐẸP -->
                <div id="ecs-ai-consult-result" class="ecs-chat-stream" aria-live="polite">
                    <div class="ecs-msg assistant">
                        <span class="ecs-msg-avatar">✳</span>
                        <div class="ecs-msg-bubble">
                            <p style="margin:0;">Xin chào! Hãy chọn nhanh câu hỏi gợi ý bên dưới hoặc nhập mẫu xe bạn quan tâm để xem <strong>thẻ thông số tóm tắt</strong> &amp; <strong>mức đặt cọc 30%</strong>.</p>
                            <small>Trợ lý VinFast · Bấm "Chọn xe" trên thẻ để tính trả góp ở Cột 1</small>
                        </div>
                    </div>
                    <div id="ecs-ai-consult-text"></div>
                </div>

                <!-- KHUNG SOẠN TIN NHẮN & GỢI Ý NHANH -->
                <form id="ecs-popup-consult-form" class="ecs-chat-compose">
                    <div id="ecs-popup-ai-prompts" class="ecs-prompts-bar">
                        <span>Gợi ý:</span>
                        <button type="button" class="ecs-prompt-chip" data-ai-popup-prompt="Tầm hoạt động và thời gian sạc của VF 7">⚡ Thông số VF 7</button>
                        <button type="button" class="ecs-prompt-chip" data-ai-popup-prompt="So sánh VF 5 và VF 6">⇄ So sánh VF 5 &amp; VF 6</button>
                        <button type="button" class="ecs-prompt-chip" data-ai-popup-prompt="Dòng xe nào 7 chỗ cho gia đình?">✧ Xe 7 chỗ gia đình</button>
                        <button type="button" class="ecs-prompt-chip" data-ai-popup-prompt="Giá xe VF 3 và phương án đặt cọc">◉ Giá &amp; Cọc VF 3</button>
                        <button type="button" class="ecs-prompt-chip" data-ai-popup-prompt="Danh mục tất cả các dòng xe trong dự án">▤ Tất cả mẫu xe</button>
                    </div>
                    <div class="ecs-compose-row">
                        <textarea name="message" id="ecs-consult-message" rows="2" maxlength="800" placeholder="Hỏi nhanh thông số xe hoặc gửi yêu cầu cho Sales Staff..." aria-label="Nội dung câu hỏi hoặc yêu cầu tư vấn" required></textarea>
                        <button type="submit" id="ecs-consult-submit-btn" class="button button-primary ecs-send-btn">Gửi <span>↑</span></button>
                    </div>
                    <div id="ecs-ai-consult-cta" class="ecs-login-cta">
                        Cần Sales Staff báo giá lăn bánh &amp; giữ chỗ xe?
                        <a href="<c:url value='/login' />">Đăng nhập tài khoản Khách hàng →</a>
                    </div>
                </form>

                <!-- KHỐI LỊCH SỬ & CHAT VỚI SALES STAFF (KHI ĐÃ ĐĂNG NHẬP) -->
                <div id="ecs-staff-consult-section" class="ecs-staff-section">
                    <div class="ecs-staff-section-head">
                        <strong>Phiên trao đổi với Sales Staff</strong>
                        <span>PENDING / Đang tư vấn: được nhắn tiếp · Hoàn tất: khóa chat</span>
                    </div>
                    <div id="ecs-consult-history-list" class="ecs-consult-history">Đang tải...</div>
                </div>
            </div>
        </div>
    </div>
</div>

<button type="button" id="ecs-consult-fab" class="ecs-consult-fab" data-open-consult-popup title="Mở hộp thoại tư vấn & báo giá">
    <span class="ecs-fab-dot"></span> ✦ Tư vấn &amp; Báo giá
</button>

<style>
.toast { z-index: 100005 !important; }
.ecs-consult-fab {
    position: fixed; right: 24px; bottom: 24px; z-index: 9990;
    background: #101113; color: #ffffff; border: 1px solid rgba(255,255,255,0.14);
    border-radius: 999px; padding: 11px 18px; font-weight: 700; font-size: 12.5px;
    font-family: var(--font, "Be Vietnam Pro", sans-serif);
    cursor: pointer; box-shadow: 0 14px 34px rgba(16, 17, 19, 0.28);
    display: inline-flex; align-items: center; gap: 7px;
    transition: all 0.2s ease;
}
.ecs-consult-fab:hover {
    background: #e31837; border-color: #e31837;
    transform: translateY(-2px);
    box-shadow: 0 14px 32px rgba(227, 24, 55, 0.34);
}
.ecs-fab-dot {
    width: 7px; height: 7px; border-radius: 50%; background: #38ad7c; display: inline-block;
}
.ecs-consult-popup {
    position: fixed; right: 20px; bottom: 20px; z-index: 9999;
    width: min(880px, calc(100vw - 32px)); max-height: 88vh;
    background: #f7f7f6; color: #17191d; border: 1px solid #e2e4e8;
    border-radius: 12px; box-shadow: 0 24px 64px rgba(16, 17, 19, 0.28);
    display: flex; flex-direction: column; overflow: hidden;
    font-family: var(--font, "Be Vietnam Pro", sans-serif);
    transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
}
.ecs-consult-popup[hidden] { display: none !important; }
.ecs-consult-popup.is-fullscreen {
    top: 14px; left: 14px; right: 14px; bottom: 14px;
    width: calc(100vw - 28px); max-width: 1400px;
    height: calc(100vh - 28px); max-height: calc(100vh - 28px);
    margin: 0 auto; border-radius: 12px;
    box-shadow: 0 32px 80px rgba(0, 0, 0, 0.5);
    z-index: 100001;
}
.ecs-consult-header {
    display: flex; justify-content: space-between; align-items: center;
    padding: 13px 18px; background: #101113; color: #ffffff;
    border-bottom: 1px solid rgba(255,255,255,0.08); user-select: none;
}
.ecs-vf-mark {
    width: 30px; height: 30px; display: grid; place-items: center;
    border: 2px solid #e31837; border-radius: 9px 3px 9px 3px;
    color: #fff; font: 800 16px/1 "Manrope", sans-serif; transform: skew(-5deg);
}
.ecs-consult-actions { display: flex; gap: 8px; }
.ecs-consult-actions button {
    background: rgba(255,255,255,0.1); color: #fff; border: 1px solid rgba(255,255,255,0.2);
    border-radius: 6px; padding: 5px 11px; font-size: 11.5px; font-weight: 600; cursor: pointer;
    font-family: inherit; transition: all 0.15s ease;
}
.ecs-consult-actions button:hover {
    background: #e31837; border-color: #e31837;
}
.ecs-consult-body { padding: 14px; overflow-y: auto; flex: 1; background: #f7f7f6; }
.ecs-consult-grid { display: grid; grid-template-columns: 340px minmax(0, 1fr); gap: 14px; align-items: start; }
.ecs-consult-popup.is-fullscreen .ecs-consult-grid { grid-template-columns: 400px minmax(0, 1fr); height: 100%; align-items: stretch; }
@media (max-width: 840px) {
    .ecs-consult-grid, .ecs-consult-popup.is-fullscreen .ecs-consult-grid { grid-template-columns: 1fr; }
}
.ecs-consult-popup [hidden] { display: none !important; }

.ecs-consult-card {
    background: #ffffff; border: 1px solid #e9eaec; border-radius: 10px; padding: 15px;
    box-shadow: 0 6px 20px rgba(27, 30, 37, 0.04); display: flex; flex-direction: column;
}
.ecs-chat-card { padding: 0; overflow: hidden; }
.ecs-card-head {
    display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;
}
.ecs-overline {
    display: block; font-size: 9px; font-weight: 700; letter-spacing: 1.2px; color: #858a92; margin-bottom: 2px;
}
.ecs-card-head h3 {
    margin: 0; font-size: 13.5px; font-weight: 700; color: #17191d;
}
.ecs-step-tag {
    font-size: 9.5px; font-weight: 700; padding: 3px 7px; border-radius: 4px;
    background: #f4f4f5; color: #676a71; letter-spacing: 0.5px;
}
.ecs-field { display: block; font-size: 11.5px; font-weight: 600; color: #565960; }
.ecs-field select, .ecs-field textarea, .ecs-field input {
    width: 100%; margin-top: 4px; padding: 8px 10px; border: 1px solid #e5e6e8;
    border-radius: 6px; font-size: 12px; font-family: inherit; color: #17191d; background: #fff;
    outline: none; transition: border-color 0.15s ease, box-shadow 0.15s ease;
}
.ecs-field select:focus, .ecs-field textarea:focus, .ecs-field input:focus {
    border-color: #d36172; box-shadow: 0 0 0 3px rgba(227, 24, 55, 0.08);
}
.ecs-calc-summary {
    margin-top: 12px; padding: 12px; background: #fcfcfc;
    border: 1px solid #e9eaec; border-left: 3px solid #e31837; border-radius: 6px;
    font-size: 11.5px; line-height: 1.65; color: #17191d;
}
.ecs-footnote {
    display: flex; align-items: flex-start; gap: 7px; margin: 10px 0 0;
    padding: 8px 10px; background: #f7f9fc; border: 1px solid #e8eaf0; border-radius: 6px;
    font-size: 10.5px; color: #7f8590; line-height: 1.5;
}
.ecs-footnote > span {
    flex: none; width: 15px; height: 15px; display: grid; place-items: center;
    border-radius: 50%; background: #e8eef8; color: #687ea4; font-size: 9px; font-weight: 700;
}

/* ĐỒNG BỘ HEADER & BONG BÓNG CHAT VỚI CUSTOMER-AI.CSS */
.ecs-chat-top {
    display: flex; align-items: center; gap: 10px; padding: 12px 15px;
    border-bottom: 1px solid #f0f0f1; background: #ffffff;
}
.ecs-chat-avatar, .ecs-msg-avatar {
    display: grid; place-items: center; border-radius: 8px;
    background: #fae9ec; color: #c41f39; font-weight: 700; flex: none;
}
.ecs-chat-avatar { width: 32px; height: 32px; font-size: 15px; }
.ecs-chat-top > div:nth-child(2) { display: grid; gap: 1px; }
.ecs-chat-top strong { font-size: 12.5px; color: #17191d; }
.ecs-chat-top > div:nth-child(2) span {
    display: flex; align-items: center; gap: 5px; color: #858a92; font-size: 10.5px;
}
.ecs-chat-top > div:nth-child(2) i {
    width: 6px; height: 6px; border-radius: 50%; background: #38ad7c; display: inline-block;
}
.ecs-mode-badge {
    margin-left: auto; font-size: 9.5px; font-weight: 700; padding: 3px 8px; border-radius: 4px;
    background: #fae9ec; color: #c41f39; letter-spacing: 0.6px; text-transform: uppercase;
}
.ecs-mode-badge.is-staff {
    background: #eef2ff; color: #1d4ed8;
}

/* KHUNG TIN NHẮN TRỰC QUAN */
.ecs-chat-stream {
    max-height: 290px; overflow-y: auto; display: flex; flex-direction: column;
    gap: 10px; padding: 13px 15px; background: #fcfcfc;
}
.ecs-consult-popup.is-fullscreen .ecs-chat-stream {
    max-height: none; flex: 1;
}
.ecs-msg {
    display: flex; align-items: flex-start; gap: 8px; max-width: 96%;
}
.ecs-msg.user {
    margin-left: auto; flex-direction: row-reverse;
}
.ecs-msg-avatar {
    width: 25px; height: 25px; font-size: 12px; border-radius: 7px;
}
.ecs-msg.user .ecs-msg-avatar {
    background: #17191d; color: #ffffff; font-size: 10px;
}
.ecs-msg-bubble {
    padding: 9px 12px; border: 1px solid #eeeff0; border-radius: 2px 10px 10px 10px;
    background: #ffffff; color: #334155; font-size: 12px; line-height: 1.6;
    box-shadow: 0 2px 5px rgba(0,0,0,0.02); min-width: 0; flex: 1;
}
.ecs-msg.user .ecs-msg-bubble {
    background: #17191d; color: #ffffff; border-color: #17191d;
    border-radius: 10px 2px 10px 10px; flex: initial;
}
.ecs-msg-bubble small {
    display: block; margin-top: 5px; color: #a0a2a8; font-size: 10px;
}
.ecs-msg.user .ecs-msg-bubble small {
    color: rgba(255,255,255,0.65); text-align: right;
}

/* KHUNG SOẠN TIN NHẮN & PROMPT CHIPS ĐỒNG BỘ */
.ecs-chat-compose {
    padding: 11px 15px; border-top: 1px solid #ededee; background: #ffffff;
}
.ecs-prompts-bar {
    display: flex; align-items: center; gap: 5px; flex-wrap: wrap; margin-bottom: 8px;
}
.ecs-prompts-bar > span {
    color: #96999f; font-size: 10.5px; font-weight: 600; margin-right: 2px;
}
.ecs-prompt-chip {
    padding: 4px 10px; border: 1px solid #e9e9eb; border-radius: 20px;
    background: #ffffff; color: #565960; font-size: 11px; font-weight: 500;
    cursor: pointer; transition: all 0.15s ease;
}
.ecs-prompt-chip:hover {
    border-color: #e9bac2; color: #b91d37; background: #fff9fa;
}
.ecs-compose-row {
    display: flex; align-items: stretch; gap: 8px;
}
.ecs-compose-row textarea {
    flex: 1; min-height: 40px; max-height: 90px; resize: vertical;
    padding: 8px 11px; border: 1px solid #e5e6e8; border-radius: 6px;
    font-size: 12px; font-family: inherit; outline: none;
}
.ecs-compose-row textarea:focus {
    border-color: #d36172; box-shadow: 0 0 0 3px rgba(227, 24, 55, 0.08);
}
.ecs-send-btn {
    padding: 0 15px; font-size: 12px; font-weight: 700; border-radius: 6px;
    white-space: nowrap; display: inline-flex; align-items: center; gap: 4px;
}
.ecs-login-cta {
    margin-top: 8px; padding-top: 7px; border-top: 1px dashed #ededee;
    font-size: 11px; color: #7f8590; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 4px;
}
.ecs-login-cta a {
    color: #e31837; font-weight: 700; text-decoration: none;
}
.ecs-login-cta a:hover { text-decoration: underline; }

/* THẺ XE TRỰC QUAN TRONG BONG BÓNG CHAT (GỌN, ÍT CHỮ, DỄ ĐỌC) */
.ecs-vhero {
    background: #fcfcfc; border: 1px solid #e9eaec; border-radius: 8px; padding: 11px; margin-top: 6px;
}
.ecs-vhero-head {
    display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; margin-bottom: 9px;
}
.ecs-vhero-badge {
    display: inline-block; font-size: 9.5px; font-weight: 700; text-transform: uppercase;
    background: #fae9ec; color: #c41f39; padding: 2px 7px; border-radius: 4px; margin-bottom: 3px;
}
.ecs-vhero-title {
    margin: 0; font-size: 14.5px; font-weight: 800; color: #17191d;
}
.ecs-vhero-pricebox { text-align: right; }
.ecs-vhero-price { display: block; font-size: 14px; font-weight: 800; color: #e31837; }
.ecs-vhero-dep { display: block; font-size: 10.5px; color: #64748b; margin-top: 1px; }

.ecs-vhero-metrics {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; margin-bottom: 9px;
}
@media (max-width: 560px) {
    .ecs-vhero-metrics { grid-template-columns: repeat(2, 1fr); }
}
.ecs-vmetric {
    background: #ffffff; border: 1px solid #ededee; border-radius: 6px; padding: 7px 6px;
    display: flex; flex-direction: column; text-align: center;
}
.ecs-vmetric .m-icon { font-size: 13px; margin-bottom: 2px; }
.ecs-vmetric .m-label { font-size: 9px; color: #858a92; font-weight: 600; text-transform: uppercase; }
.ecs-vmetric .m-val { font-size: 11.5px; font-weight: 700; color: #17191d; margin-top: 1px; }
.ecs-vmetric .m-sub { font-size: 9px; color: #96999f; }

.ecs-vhero-body {
    background: #ffffff; border-left: 3px solid #e31837; border-radius: 0 5px 5px 0;
    padding: 7px 10px; font-size: 11.5px; line-height: 1.5; color: #475569; margin-bottom: 9px;
}
.ecs-btn-select-main {
    width: 100%; padding: 7px 12px; background: #17191d; color: #fff; border: 0;
    border-radius: 6px; font-size: 11.5px; font-weight: 700; cursor: pointer;
    font-family: inherit; transition: background 0.15s ease;
}
.ecs-btn-select-main:hover { background: #e31837; }

/* LƯỚI DANH MỤC TẤT CẢ MẪU XE */
.ecs-catalog-intro { font-size: 11.5px; font-weight: 700; color: #17191d; margin-bottom: 8px; }
.ecs-catalog-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 6px; }
@media (max-width: 560px) { .ecs-catalog-grid { grid-template-columns: 1fr; } }
.ecs-catalog-card {
    background: #ffffff; border: 1px solid #e9eaec; border-radius: 7px; padding: 9px 10px;
    display: flex; flex-direction: column; justify-content: space-between;
}
.ecs-cat-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 4px; margin-bottom: 5px; }
.ecs-cat-name { font-size: 12.5px; font-weight: 800; color: #17191d; }
.ecs-cat-seg { font-size: 9.5px; color: #858a92; }
.ecs-cat-price { font-size: 11.5px; font-weight: 700; color: #e31837; }
.ecs-cat-pills { display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 7px; }
