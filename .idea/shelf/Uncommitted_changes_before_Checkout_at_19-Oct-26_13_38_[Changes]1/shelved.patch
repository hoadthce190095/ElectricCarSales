+    private static void validateNumbers(BigDecimal budget, BigDecimal range, Integer seats) {
+        if (budget != null && (budget.signum() <= 0 || budget.compareTo(new BigDecimal("9999999999999999.99")) > 0
+            || budget.scale() > 2)) {
+            throw new ApiException(400,
