+        }
+        Set<Integer> checkedIds = new LinkedHashSet<>();
+        for (Integer modelId : modelIds) {
+            if (modelId == null || modelId <= 0 || !checkedIds.add(modelId)) {
+                throw new ApiException(400, "Chọn tối đa 8 mã mẫu xe hợp lệ, không trùng lặp.");
+            }
+        }
+    }
