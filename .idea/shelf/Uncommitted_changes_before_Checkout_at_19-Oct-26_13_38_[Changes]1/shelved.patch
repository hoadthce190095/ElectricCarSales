+                    "name: " + old.getEmployeeName() + " -> " + valid.getEmployeeName() + "; phone: " + old.getPhone()
+                        + " -> " + valid.getPhone() + "; email: " + old.getEmail() + " -> " + valid.getEmail());
+                connection.commit();
